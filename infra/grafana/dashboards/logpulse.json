  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "컨테이너별 CPU / RAM 사용률",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 10,
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/ RAM$/" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"logpulse-.+\"}[1m])) * 100",
          "legendFormat": "{{name}} CPU",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"logpulse-.+\"})",
          "legendFormat": "{{name}} RAM",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "컨테이너별 Network / Disk I/O",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 11,
      "fieldConfig": {
        "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"logpulse-.+\"}[1m]))",
          "legendFormat": "{{name}} RX",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"logpulse-.+\"}[1m]))",
          "legendFormat": "{{name}} TX",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "C",
          "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"logpulse-.+\"}[1m]))",
          "legendFormat": "{{name}} Disk Read",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "D",
          "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"logpulse-.+\"}[1m]))",
          "legendFormat": "{{name}} Disk Write",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 1,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumer_group, topic) (kafka_consumer_lag)",
          "legendFormat": "{{consumer_group}}/{{topic}}",
          "range": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "type": "timeseries",
