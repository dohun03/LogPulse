CONSUMER_ROLE=click
KAFKA_BROKERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_CLIENT_ID=logpulse-consumer-worker
KAFKA_CLICK_TOPIC=click-events
KAFKA_PAYMENT_TOPIC=payment-events
KAFKA_PAYMENT_DLQ_TOPIC=payment-events-dlq
CLICK_CONSUMER_GROUP_ID=logpulse-click-loader
PAYMENT_CONSUMER_GROUP_ID=logpulse-payment-loader
REDIS_URL=redis://localhost:6379
REDIS_CLICK_DEDUP_TTL_SEC=600
REDIS_PAYMENT_DEDUP_TTL_SEC=86400
CLICK_BATCH_MAX_SIZE=500
CLICK_BATCH_FLUSH_MS=1000
PAYMENT_MAX_RETRY=3
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=logpulse
CLICKHOUSE_USERNAME=logpulse_writer
CLICKHOUSE_PASSWORD=logpulse-writer-dev
LOG_LEVEL=info
